{
  "name": "urdeck",
  "version": "2.0.0",
  "private": true,
  "description": "UrDeck: study anything with spaced-repetition flashcards, a 3D lab and live quizzes. Next.js + Supabase.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "import": "tsx scripts/import.ts",
    "import:dry": "tsx scripts/import.ts --dry",
    "build:mobile": "node scripts/build-mobile.mjs",
    "android:sync": "npm run build:mobile && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^5.1.0",
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.2.3",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-ethiopic": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@supabase/supabase-js": "^2.45.0",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "next": "14.2.35",
    "pdfjs-dist": "3.11.174",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.17.0",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.18"
  }
}
